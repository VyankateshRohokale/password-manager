# Copy to .env and fill in real values. .env is git-ignored and is read automatically on startup.

# PostgreSQL connection used by the application
DB_URL=jdbc:postgresql://localhost:5432/vault
DB_USERNAME=vault_app
DB_PASSWORD=change-me

# Separate database used by the integration tests (it is wiped between tests)
TEST_DB_URL=jdbc:postgresql://localhost:5432/vault_test

# Secret used to derive decoy salts for unknown emails on /api/auth/prelogin.
# Generate one with: openssl rand -base64 32
VAULT_PRELOGIN_SECRET=replace-with-a-long-random-value

# HTTP port
PORT=8787

# Must be true in production (HTTPS). Set to false only for local http://localhost development.
COOKIE_SECURE=false

# Server session idle timeout
SESSION_TIMEOUT=30m

# Optional built-in HTTPS
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12

# Set to "native" only when running behind a trusted reverse proxy that sets X-Forwarded-* headers
FORWARD_HEADERS_STRATEGY=none
